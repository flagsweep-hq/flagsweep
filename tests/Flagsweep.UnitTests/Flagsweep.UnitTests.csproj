<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="FluentAssertions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
  </ItemGroup>

  <!-- No reference to Flagsweep.Api: unit tests must not be able to spin up a host. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\api\Flagsweep.Domain\Flagsweep.Domain.csproj" />
    <ProjectReference Include="..\..\src\api\Flagsweep.Application\Flagsweep.Application.csproj" />
    <ProjectReference Include="..\..\src\api\Flagsweep.Infrastructure\Flagsweep.Infrastructure.csproj" />
  </ItemGroup>
</Project>
